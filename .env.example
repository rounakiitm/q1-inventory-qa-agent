# Copy to .env and fill in
GEMINI_API_KEY=your_key_here
# Or a rotating pool:
# GEMINI_API_KEYS=key1,key2,key3

# optional model overrides
# MODEL_NAME=gemini-3.1-flash-lite
# MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.5-flash
# SANDBOX_TIMEOUT_S=15
# AGENT_MAX_ITERATIONS=15

# ---------------------------------------------------------------------------
# Supabase (production). Leave blank for local SQLite + anonymous user.
# Project Settings → API: URL, anon key, service_role key, JWT Secret.
# Then run supabase/schema.sql in the SQL Editor.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret
# AUTH_DISABLED=false
